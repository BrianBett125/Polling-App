# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required for voting. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Signs voter cookies; defaults to SUPABASE_SERVICE_ROLE_KEY. Server only.
VOTER_COOKIE_SECRET=
# Only for `npm run db:migrate` (direct Postgres connection string).
SUPABASE_DB_URL=
# Only for `npm run test:db` (a throwaway local Postgres, never a real project).
TEST_DATABASE_URL=
# Optional: Cloudflare Turnstile (voting and sign-up). Both needed to turn it on; see docs/SECURITY.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Sentry error reporting. Unset = not bundled, nothing sent. See docs/OBSERVABILITY.md.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: canonical site URL for link previews.
NEXT_PUBLIC_SITE_URL=
